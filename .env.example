# Yarnhub — copy to .env.local. Never commit secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by newer Supabase projects:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key as 64 hex chars, or any passphrase (hashed with SHA-256).
SMS_CREDENTIALS_KEY=

# mock (default, local/CI) | mobile_message (real BYO sends)
SMS_PROVIDER=mock

# Used to display webhook URLs. Production:
# NEXT_PUBLIC_APP_URL=https://yarnhub.reveille.net.au
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel cron Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Comma-separated emails that can open /platform (hosted pool, KYC, panic suspend).
PLATFORM_ADMIN_EMAILS=

# Stripe (Vercel Marketplace integration). Checkout credits hosted SMS packs.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CREDIT_PACK_SIZE=100
# STRIPE_CREDIT_PACK_CENTS=2000

